JWT_SECRET=your-secret-key-here
RESEND_API_KEY=your-resend-key-here
RESEND_FROM_EMAIL=ClearCall <onboarding@resend.dev>
ABN_API_GUID=57bec0d9-7b1d-47eb-ac80-0be5b16ccce3
TWILIO_ACCOUNT_SID=your-twilio-sid-here
TWILIO_AUTH_TOKEN=your-twilio-token-here
TWILIO_PHONE_NUMBER=your-twilio-number-here
TWILIO_API_KEY=your-twilio-api-key-here
TWILIO_API_SECRET=your-twilio-api-secret-here
TWILIO_TWIML_APP_SID=your-twiml-app-sid-here
DATABASE_PATH=./clearcall.db
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:3000

# Super Admin Panel (/admin). ADMIN_PASSWORD must be a bcrypt HASH, not a
# plain password. Generate one with:
#   node -e "console.log(require('bcryptjs').hashSync('your-password', 12))"
ADMIN_PASSWORD=your-bcrypt-hash-here
ADMIN_JWT_SECRET=your-separate-admin-secret-here

# AI Assistant portal (/admin/ai-assistant). Optional — the portal shows a
# clear "not configured" state if this is left unset instead of erroring.
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-sonnet-5

# Web push notifications. Generate a real pair with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=your-vapid-public-key-here
VAPID_PRIVATE_KEY=your-vapid-private-key-here
VAPID_SUBJECT=mailto:support@yourdomain.com

# Job Search screen — external listings via Adzuna. Optional — free keys
# from https://developer.adzuna.com. Left unset, Job Search shows ClearCall
# Direct postings only (no external results, no error).
ADZUNA_APP_ID=your-adzuna-app-id-here
ADZUNA_APP_KEY=your-adzuna-app-key-here

# Gmail connect (Settings > Connect Gmail, for automatic application
# tracking). Optional — a real Google Cloud OAuth client. Left unset, the
# Connect Gmail button shows a clear "not configured" state.
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id-here
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret-here

# Firebase Cloud Messaging — sends verified-call/application-update push
# notifications to registered device tokens, in addition to the VAPID web
# push above. Get a key from the Firebase console: Project Settings > Cloud
# Messaging > "Server key" (under Cloud Messaging API (Legacy)). NOTE: this
# is Google's legacy FCM HTTP API, which Google retired for new usage in
# June 2024 — on a modern Firebase project this key type may no longer work,
# and Google's current replacement (FCM HTTP v1) requires a service-account
# JSON + OAuth2 instead of a bare key. Left unset, FCM sends are skipped and
# ClearCall's VAPID web push remains the real, working notification channel.
FIREBASE_SERVER_KEY=your-firebase-server-key-here
